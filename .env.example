# Copy to .env and change what you need. Everything here is optional.

# Hugging Face token (gated models such as Llama or Gemma, and faster downloads)
# LLMT_HF_TOKEN=

# llama.cpp is installed from the System page (into tools/llama.cpp). Only set this to use another checkout:
#   git clone https://github.com/ggml-org/llama.cpp && cd llama.cpp && cmake -B build && cmake --build build -j
# LLMT_LLAMA_CPP_DIR=/path/to/llama.cpp

# Default embedding model for RAG and similarity metrics
# LLMT_DEFAULT_EMBED_MODEL=intfloat/multilingual-e5-small

# Data folder (datasets, models, outputs, database)
# LLMT_DATA_DIR=/path/to/data

# Listen on the local network (default: localhost only). The app has no login: only do this on a trusted network.
# LLMT_HOST=0.0.0.0

# OpenAI-compatible API (/v1): when set, requests must send 'Authorization: Bearer <key>'
# LLMT_API_KEY=

# Automatic backups (database, datasets and RAG) into data/backups
# LLMT_BACKUP_DAILY=true
# LLMT_BACKUP_KEEP=7
